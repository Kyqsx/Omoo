# Copie este arquivo para ".env" (uso local) e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o Git.
# Em produção (Railway), essas mesmas chaves são configuradas no painel
# do Railway em "Variables" — não existe arquivo .env lá.

# A Railway injeta a variável PORT automaticamente. Localmente, usamos 3000.
PORT=3000

# --- PostgreSQL via Supabase ---
# Pegue em: Supabase Dashboard > Project Settings > Database > Connection string
# Use a versão "Connection Pooling" (porta 6543, modo transaction) se seu
# plano/uso tiver muitas conexões simultâneas; a "Direct connection"
# (porta 5432) funciona bem para a maioria dos casos com o Railway.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Deixe "true" (padrão) para Supabase. Só mude para "false" se estiver
# rodando um Postgres 100% local sem SSL configurado.
DATABASE_SSL=true

# --- Redis (fila de matchmaking) ---
# Na Railway: adicione o plugin "Redis" ao projeto e ele cria a variável
# REDIS_URL automaticamente (referencie ${{Redis.REDIS_URL}} nas Variables
# do serviço backend, ou copie o valor gerado). Localmente, use um Redis
# rodando na sua máquina.
REDIS_URL=redis://localhost:6379

# --- Autenticação ---
# String aleatória longa usada para assinar os tokens de login (JWT).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilize esse valor entre projetos, e nunca o exponha publicamente.
JWT_SECRET=troque_por_um_valor_aleatorio_bem_longo

# --- Frontend (Vercel) ---
# URL pública do seu frontend na Vercel, usada para configurar o CORS.
# Pode listar várias separadas por vírgula (ex: produção + preview + local).
FRONTEND_URL=https://seu-app.vercel.app,http://localhost:5173

# --- Stripe ---
# Chave secreta da sua conta Stripe (dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Segredo do endpoint de Webhook (gerado quando você cria o webhook no Stripe
# ou quando roda o "stripe listen" localmente, veja o README)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ID do Preço (Price) recorrente mensal criado no Stripe Dashboard
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# URLs para onde o Stripe Checkout redireciona após sucesso/cancelamento.
# Essas páginas ficam no FRONTEND (Vercel), não no backend — o usuário
# termina o pagamento numa página do Stripe e volta pro seu site.
CHECKOUT_SUCCESS_URL=https://seu-app.vercel.app/sucesso
CHECKOUT_CANCEL_URL=https://seu-app.vercel.app/cancelado
